# Optional: without this, the API uses local JSON storage in server/data/local-db.json.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=belayneh_portfolio
API_PORT=5001
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
CONTACT_NOTIFICATION_EMAIL=your-contact-email@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-admin-mailbox@gmail.com
SMTP_PASS=your-mail-provider-app-password
SMTP_FROM=your-admin-mailbox@gmail.com
ADMIN_RECOVERY_EMAIL=your-admin-mailbox@gmail.com
PUBLIC_APP_URL=http://localhost:3000
